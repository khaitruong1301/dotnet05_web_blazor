</div>

@code {

    HubConnection? hubConnection;
    //oninit
    protected override async Task OnInitializedAsync()
    {
        //kết nối signalR
        hubConnection = new HubConnectionBuilder()
            .WithUrl(_navigate.ToAbsoluteUri("/roomHub"))
            .WithAutomaticReconnect()
            .Build();
        //Khởi động kết nối
        await hubConnection.StartAsync();
        // Sau khi start connection thì lắng nghe action load_lst_room
        hubConnection.On<List<string>>("load_lst_room",(lstRoom) =>{
            Console.WriteLine($@"{JsonSerializer.Serialize(lstRoom)}");
        });
    }

    //ondispose
    public void Dispose()
    {
        //ngắt kết nối signalR  
        _ = hubConnection?.DisposeAsync();
    }
}