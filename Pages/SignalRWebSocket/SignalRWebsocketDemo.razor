@page "/demo-signalr-websocket"

@inject NavigationManager _navigate

@implements IDisposable



<div class="container-fluid p-4">
    <div class="row">
        <!-- Left Sidebar - Chat Rooms -->
        <div class="col-md-3">
            <div class="card">
                <div class="card-header bg-white border-3 border-primary">
                    <h5 class="mb-0">Chat Rooms</h5>
                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <button class="btn btn-primary btn-sm" @onclick="handleAddRoom">+ Add Room</button>
                        <span class="badge bg-secondary">Room 10</span>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">

                        @foreach (string room in lstRoomDTO)
                        {
                            <a href="#"
                                class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <span>@room</span>
                                <span class="badge bg-primary rounded-pill">@room</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side - Chat Area -->
        <div class="col-md-9">
            <div class="card h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Room 1</h5>
                    <button class="btn btn-danger btn-sm">Leave Room</button>
                </div>
                <div class="card-body">
                    <!-- Message from User1 -->
                    <div class="mb-3">
                        <div class="d-flex">
                            <div>
                                <strong>User1</strong>
                                <div class="bg-light p-2 rounded">
                                    <p class="mb-0">Hello everyone!</p>
                                </div>
                                <small class="text-muted">10:30 AM</small>
                            </div>
                        </div>
                    </div>

                    <!-- Message from You -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-end">
                            <div class="text-end">
                                <strong>You</strong>
                                <div class="bg-primary text-white p-2 rounded">
                                    <p class="mb-0">Hi! How are you?</p>
                                </div>
                                <small class="text-muted">10:31 AM</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {

    HubConnection? hubConnection;

    List<string> lstRoomDTO = new List<string>();
    //oninit
    protected override async Task OnInitializedAsync()
    {
        //kết nối signalR
        hubConnection = new HubConnectionBuilder()
        .WithUrl(_navigate.ToAbsoluteUri("/roomHub"))
        .WithAutomaticReconnect()
        .Build();
        //Khởi động kết nối
        await hubConnection.StartAsync();
        // Sau khi start connection thì lắng nghe action load_lst_room
        hubConnection.On<List<string>>("load_lst_room", async(lstRoom) =>
        {
            lstRoomDTO = lstRoom;
            await InvokeAsync(StateHasChanged);//Gọi render lại giao diện
        });

        //Gọi nghiệp vụ loadAllRom từ RoomHubServer
        if (hubConnection is not null)
        {
            await hubConnection.InvokeAsync("getAllRoom");
        }
    }

    public async Task handleAddRoom()
    {
        if (hubConnection is not null)
        {
            //gọi hàm add_room trên hub
            await hubConnection.InvokeAsync("add_room", @$"Room {lstRoomDTO.Count+1}");
        }
    }

    //ondispose
    public void Dispose()
    {
        //ngắt kết nối signalR
        _ = hubConnection?.DisposeAsync();
    }
}