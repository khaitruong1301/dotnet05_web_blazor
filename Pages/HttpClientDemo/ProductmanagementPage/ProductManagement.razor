@page "/productmanagement"

@inject ProductManagementService _productService;
@implements IDisposable


<div class="container">
    <h3>Product Management Page</h3>
    <NavLink class="btn btn-success mb-2" href="/add-new-product">Add New Product</NavLink>
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Price</th>
                <th>Image</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach(ProductDTO prod in _productService._lstProduct){
                <tr>
                    <td>@prod.Id</td>
                    <td>@prod.Name</td>
                    <td>@prod.Price</td>
                    <td>
                        <img src="@prod.Image" width="100" height="100" />
                    </td>
                    <td>
                        <button class="btn btn-danger">Delete</button>
                        <button class="btn btn-primary">Edit</button>
                    </td>
                </tr>
            }
           
        </tbody>
    </table>
</div>


@code{
    protected override async Task OnInitializedAsync()
    {
        _productService.OnChange += StateHasChanged;

        //Gọi api lấy danh sách product
        await _productService.GetAllProduct();
    }

    public void Dispose()
    {
        _productService.OnChange -= StateHasChanged;
    }
}